# MongoDB Atlas connection string.
# Create a free cluster at https://www.mongodb.com/atlas, then copy your connection string.
# Replace <username>, <password> and <cluster> with your own values.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/project-pro?retryWrites=true&w=majority"

# Auth.js (NextAuth v5). Generate your own with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public base URL used by the app for links/meta (localhost in dev, your Vercel URL in prod).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary credentials from https://cloudinary.com (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
