generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
  MEMBER
}

enum ProjectStatus {
  ONGOING
  COMPLETED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String?
  email     String   @unique
  password  String?
  image     String?
  phone     String?
  location  String?
  userLogo  String?
  companyName        String?
  companyDescription String?
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User?     @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownerId        String?   @db.ObjectId
  createdClients User[]    @relation("ClientOwner")

  ownedProjects  Project[]       @relation("ProjectOwner")
  clientProjects Project[]       @relation("ProjectClient")
  comments       ProjectComment[]
  paymentsMade   Payment[]       @relation("PaymentOwner")
  clientPayments Payment[]       @relation("PaymentClient")

  @@map("users")
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String        @unique
  description String?
  notes       String?
  thumbnail   String?
  bannerImage String?
  gradient    String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Int           @default(0)
  status      ProjectStatus @default(ONGOING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner   User   @relation("ProjectOwner", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId  String @db.ObjectId

  client   User?  @relation("ProjectClient", fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientId String? @db.ObjectId

  comments ProjectComment[]
  payments Payment[]
  modules  Module[]

  @@map("projects")
}

model Payment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  amount        Int
  tax           Int      @default(0)
  date          DateTime @default(now())
  method        String
  invoiceNumber String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId String  @db.ObjectId

  owner   User   @relation("PaymentOwner", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId  String @db.ObjectId

  client   User?  @relation("PaymentClient", fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientId String? @db.ObjectId

  @@map("payments")
}

model ProjectComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  userId    String   @db.ObjectId
  username  String
  userRole  UserRole @default(MEMBER)
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId String  @db.ObjectId

  author   User   @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId String @db.ObjectId

  @@map("project_comments")
}

model Module {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  userId    String   @db.ObjectId
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId String  @db.ObjectId

  @@map("modules")
}
